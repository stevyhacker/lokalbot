# Generated by xcodegen — recreate with `xcodegen generate`. Keep only the
# SwiftPM lockfile so release/CI builds resolve the exact reviewed revisions.
LokalBot.xcodeproj/*
!LokalBot.xcodeproj/project.xcworkspace/
LokalBot.xcodeproj/project.xcworkspace/*
!LokalBot.xcodeproj/project.xcworkspace/xcshareddata/
LokalBot.xcodeproj/project.xcworkspace/xcshareddata/*
!LokalBot.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
LokalBot.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!LokalBot.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

